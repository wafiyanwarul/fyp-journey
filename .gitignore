# ==============================================================
# FYP Journey — .gitignore
# ==============================================================

# ── OS Files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── Dependencies (jika nanti pakai npm untuk tooling) ─────────
node_modules/
package-lock.json
yarn.lock

# ── Environment & Secrets ─────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ── Build Output (jika nanti pakai bundler) ───────────────────
dist/
build/
.cache/
.parcel-cache/
.vite/

# ── Temp & Backup Files ───────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*~

# ── Local Dev Tools ───────────────────────────────────────────
.serve/
.netlify/

# ── Asset Source Files (jika ada raw design files) ────────────
*.psd
*.ai
*.sketch
*.fig